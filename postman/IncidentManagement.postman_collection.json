{
  "info": {
    "name": "Incident Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All HTTP endpoints. Run the app with the seed profile (see README). The caller is the X-User-Id header: a username (ada, alice, bob, carol, dan, erin) or a user id; users are collection variables (ada = admin, bob = reporter, dan & alice = Database team, carol = Platform). Run 'Report incident' first: it stores {{incidentId}}."
  },
  "item": [
    {
      "name": "Organization",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        },
        {
          "name": "List teams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams"
              ]
            }
          }
        },
        {
          "name": "Get team (Database)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamDatabase}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamDatabase}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Incidents - create & list",
      "item": [
        {
          "name": "Report incident (Bob, Database category)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"DB slow\",\n  \"description\": \"timeouts on checkout\",\n  \"categoryId\": \"{{categoryDatabase}}\",\n  \"severity\": \"SEV2\"\n}"
            },
            "description": "Creates an OPEN incident owned by the Database team. Saves its id as {{incidentId}} for the other requests. A reporter may set at most SEV2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('incidentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List all incidents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            }
          }
        },
        {
          "name": "List my reported incidents (Bob)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "mine"
              ]
            }
          }
        },
        {
          "name": "List incidents reported by a user (Bob)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{bob}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{bob}}",
                "incidents"
              ]
            }
          }
        },
        {
          "name": "List team incidents (Database, any status)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamDatabase}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamDatabase}}",
                "incidents"
              ]
            }
          }
        },
        {
          "name": "Team queue (Database, active only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamDatabase}}/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamDatabase}}",
                "queue"
              ]
            }
          }
        },
        {
          "name": "Get incident",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Incidents - update",
      "item": [
        {
          "name": "Update title / description (reporter)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Primary DB slow\",\n  \"description\": \"timeouts on checkout and login\"\n}"
            },
            "description": "Either field may be omitted (null keeps the value). Owning team member or reporter; active incidents only."
          }
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"checkout is affected\"\n}"
            }
          }
        },
        {
          "name": "Change severity (no emails)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/severity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "severity"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"SEV3\"\n}"
            },
            "description": "Correction without escalation: audited, no emails."
          }
        }
      ]
    },
    {
      "name": "Incidents - status",
      "item": [
        {
          "name": "Acknowledge (OPEN -> IN_PROGRESS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/acknowledge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "acknowledge"
              ]
            }
          }
        },
        {
          "name": "Submit for review (-> IN_REVIEW)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_REVIEW\"\n}"
            }
          }
        },
        {
          "name": "Back to work (IN_REVIEW -> IN_PROGRESS)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        },
        {
          "name": "Resolve (IN_REVIEW -> RESOLVED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "resolve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"index rebuilt\"\n}"
            },
            "description": "Same as PUT /status with status RESOLVED. Needs IN_REVIEW first."
          }
        },
        {
          "name": "Reopen (RESOLVED -> IN_PROGRESS)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"note\": \"slow again\"\n}"
            }
          }
        },
        {
          "name": "Close (RESOLVED -> CLOSED)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}"
            }
          }
        },
        {
          "name": "Cancel (OPEN/IN_PROGRESS/IN_REVIEW -> CANCELLED)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\",\n  \"note\": \"duplicate\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Incidents - escalation & hand-over",
      "item": [
        {
          "name": "Escalate within the team",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/escalate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "escalate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"SEV1\",\n  \"reason\": \"replica lag growing\"\n}"
            }
          }
        },
        {
          "name": "Escalate to Platform",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/escalate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "escalate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"SEV1\",\n  \"targetTeamId\": \"{{teamPlatform}}\",\n  \"reason\": \"replica lag growing\"\n}"
            },
            "description": "Severity must go up. Handing over makes the incident OPEN for the new team."
          }
        },
        {
          "name": "De-escalate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/de-escalate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "de-escalate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"SEV3\",\n  \"reason\": \"contained\"\n}"
            },
            "description": "Severity must go down; targetTeamId optional. Caller must be in the owning team (use {{carol}} after a hand-over to Platform)."
          }
        },
        {
          "name": "Reassign to Platform (no severity change)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/reassign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "reassign"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetTeamId\": \"{{teamPlatform}}\",\n  \"reason\": \"payments side\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "History",
      "item": [
        {
          "name": "Timeline (audit)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/timeline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "timeline"
              ]
            }
          }
        },
        {
          "name": "Notifications (emails)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "notifications"
              ]
            }
          }
        },
        {
          "name": "Escalations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/escalations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "escalations"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dead-lettered notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ada}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/notifications/dead-lettered",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "notifications",
                "dead-lettered"
              ]
            }
          }
        },
        {
          "name": "Replay notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ada}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/notifications/{{notificationId}}/replay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "notifications",
                "{{notificationId}}",
                "replay"
              ]
            },
            "description": "Set {{notificationId}} to an id from the dead-lettered list."
          }
        },
        {
          "name": "User activity (Dan)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ada}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{dan}}/activity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{dan}}",
                "activity"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "401 unknown user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{unknownUser}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            }
          }
        },
        {
          "name": "403 not the owning team (Carol acknowledges)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{carol}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/acknowledge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "acknowledge"
              ]
            }
          }
        },
        {
          "name": "403 admin only (Bob)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/notifications/dead-lettered",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "notifications",
                "dead-lettered"
              ]
            }
          }
        },
        {
          "name": "404 unknown incident",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          }
        },
        {
          "name": "400 escalation without reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/escalate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "escalate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"SEV1\",\n  \"reason\": \" \"\n}"
            }
          }
        },
        {
          "name": "409 reporter may not set SEV1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{bob}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Everything down\",\n  \"categoryId\": \"{{categoryDatabase}}\",\n  \"severity\": \"SEV1\"\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "ada",
      "value": "ada",
      "description": "username, sent as X-User-Id"
    },
    {
