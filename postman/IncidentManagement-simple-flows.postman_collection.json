            "url": {
              "raw": "{{baseUrl}}/incidents/{{resolverIncidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{resolverIncidentId}}"
              ]
            },
            "description": "The team and Bob are emailed that it is resolved."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is RESOLVED', () => pm.expect(body.status).to.eql('RESOLVED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Bob receives the 'resolved' email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailpitUrl}}/api/v1/search?query=to:bob@example.com {{resolverTitle}}",
              "host": [
                "{{mailpitUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "to:bob@example.com {{resolverTitle}}"
                }
              ]
            },
            "description": "Checks Bob's inbox in Mailpit (http://localhost:8025). Waits 12 s first: emails are sent by a job every 10 s."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 12000); // the email job sends every 10 s"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const subjects = body.messages.map(m => m.Subject);",
                  "pm.test('bob@example.com got \"Resolved\"', () => pm.expect(subjects.some(s => s.includes('Resolved') && s.includes(pm.collectionVariables.get('resolverTitle')))).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Close (-> CLOSED)",
          "request": {
            "method": "PATCH",
