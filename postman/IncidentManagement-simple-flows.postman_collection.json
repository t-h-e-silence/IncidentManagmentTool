                "exec": [
                  "pm.collectionVariables.set('resolverTitle', 'Slow queries ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('resolverIncidentId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Dan receives the 'new incident' email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailpitUrl}}/api/v1/search?query=to:dan@example.com {{resolverTitle}}",
              "host": [
                "{{mailpitUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "to:dan@example.com {{resolverTitle}}"
                }
              ]
            },
            "description": "Checks Dan's inbox in Mailpit (http://localhost:8025). Waits 12 s first: emails are sent by a job every 10 s."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 12000); // the email job sends every 10 s"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const subjects = body.messages.map(m => m.Subject);",
                  "pm.test('dan@example.com got \"New incident\"', () => pm.expect(subjects.some(s => s.includes('New incident') && s.includes(pm.collectionVariables.get('resolverTitle')))).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Team incidents include it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamDatabase}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamDatabase}}",
                "incidents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('listed', () => pm.expect(body.map(i => i.id)).to.include(pm.collectionVariables.get('resolverIncidentId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. View the incident",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{resolverIncidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{resolverIncidentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is OPEN', () => pm.expect(body.status).to.eql('OPEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Start working on it (-> IN_PROGRESS)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{resolverIncidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{resolverIncidentId}}"
              ]
            },
            "description": "Bob is emailed that his incident is being worked on."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is IN_PROGRESS', () => pm.expect(body.status).to.eql('IN_PROGRESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Add a comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Found a missing index, adding it\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{resolverIncidentId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{resolverIncidentId}}",
                "comments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Edit the description",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Queries on db-01 take 5 s: missing index on orders.customer_id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{resolverIncidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{resolverIncidentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('description changed', () => pm.expect(body.description).to.include('missing index'));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Escalate SEV3 -> SEV2",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"SEV2\",\n  \"reason\": \"checkout is affected too\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{resolverIncidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{resolverIncidentId}}"
              ]
            },
            "description": "The team and Bob are emailed about the escalation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('severity is SEV2', () => pm.expect(body.severity).to.eql('SEV2'));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Submit for review (-> IN_REVIEW)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{dan}}"
              },
