                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"one entry per change, in order\", () => pm.expect(pm.response.json().map(e => e.action)).to.eql([\"INCIDENT_CREATED\", \"DETAILS_UPDATED\", \"ESCALATED\", \"STATUS_CHANGED\", \"COMMENT_ADDED\"]));",
                  "pm.test(\"hand-over recorded\", () => pm.expect(pm.response.json()[2].details.toTeam).to.eql(pm.variables.get(\"teamPlatform\")));"
                ]
              }
            }
